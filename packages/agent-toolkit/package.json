{
  "name": "@rendobar/agent-toolkit",
  "version": "0.1.1",
  "description": "Rendobar agent toolkit: the official agent tools for Rendobar's media processing and AI generation API.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://rendobar.com/integrations/vercel-ai-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rendobar/rendobar-typescript.git",
    "directory": "packages/agent-toolkit"
  },
  "bugs": {
    "url": "https://github.com/rendobar/rendobar-typescript/issues"
  },
  "keywords": [
    "rendobar",
    "video-api",
    "ffmpeg-api",
    "media-processing",
    "video-processing",
    "ai",
    "sdk",
    "typescript",
    "nodejs",
    "javascript",
    "vercel-ai-sdk",
    "mcp",
    "ai-agents",
    "tool-calling",
    "ai-sdk",
    "mastra",
    "langchain",
    "agent",
    "tools",
    "ffmpeg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rendobar/sdk": ">=5.18.0",
    "ai": "^7.0.0",
    "zod": "^4.0.0",
    "@mastra/core": ">=1.82 <2",
    "@langchain/core": ">=1.3 <2"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rendobar/sdk": "^5.18.0",
    "@types/node": "^26.6.6",
    "ai": "^7.0.179",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "@mastra/core": "1.82.0",
    "@langchain/core": "1.5.0",
    "langchain": "1.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}
