    "@rendobar/nestjs": "^0.1.0",
    "@rendobar/sdk": "^5.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
